{
  "siteUrl": "https://sharepoint.example/sites/cora",
  "requiredListPrefix": "uat_",
  "personas": [
    {
      "name": "complaints reviewer (Cases - Complaints Write)",
      "headersFileEnv": "CORA_UAT_REVIEWER_HEADERS_FILE",
      "expectations": [
        {
          "listName": "uat_Cases-Complaints",
          "read": "allow",
          "write": "allow",
          "delete": "deny"
        }
      ]
    },
    {
      "name": "adviser in no Case list group",
      "headersFileEnv": "CORA_UAT_ADVISER_HEADERS_FILE",
      "expectations": [
        {
          "listName": "uat_Cases-Complaints",
          "read": "deny",
          "write": "deny"
        }
      ]
    },
    {
      "name": "reviewer manager (CORA All Cases Read)",
      "headersFileEnv": "CORA_UAT_REVIEWER_MANAGER_HEADERS_FILE",
      "expectations": [
        {
          "listName": "uat_Cases-Complaints",
          "read": "allow",
          "write": "deny"
        }
      ]
    },
    {
      "name": "controls (CORA All Cases Write)",
      "headersFileEnv": "CORA_UAT_CONTROLS_HEADERS_FILE",
      "expectations": [
        {
          "listName": "uat_Cases-Complaints",
          "read": "allow",
          "write": "allow",
          "delete": "deny"
        }
      ]
    }
  ]
}
