{
  "name": "case-review-frontend-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit --checkJs --allowJs",
    "flow:run": "node scripts/run_in_memory_flow.js",
    "test": "node --test",
    "test:deploy": "python3 -m unittest discover -s tests -p 'test_deploy*.py'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-include='case-types/**/*.js' --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95",
    "verify": "node scripts/verify_build.js",
    "test:security": "node --test tests/html.test.js tests/permissions.test.js tests/section-access-roles.test.js tests/section-access-matrix.test.js tests/section-access-lifecycle.test.js tests/section-access-config.test.js tests/failure-evaluator.test.js tests/configured-outcome.test.js tests/uat-acl-smoke.test.js",
    "test:security:uat": "node scripts/uat_acl_smoke.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "case-types/banks/*.txt": [
      "prettier --write"
    ]
  }
}
